{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "retrycredit-helper-ledger",
  "main": "src/helper-ledger-worker.mjs",
  // Deliberately retained at the date used by the spending-coordinator tests.
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["HELPER_LEDGER_TOKEN"] },
  "vars": {
    "HELPER_LEDGER_ENABLED": "false",
    "HELPER_LEDGER_POLICY": "UNCONFIGURED"
  },
  "durable_objects": {
    "bindings": [{ "name": "HELPER_LEDGER", "class_name": "HelperSpendingLedger" }]
  },
  "migrations": [{ "tag": "helper-ledger-sqlite-v1", "new_sqlite_classes": ["HelperSpendingLedger"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
