{
  "name": "retrycredit",
  "version": "1.0.0",
  "description": "Attestcoin-verified fixed recovery credits for paid Ethereum failure-to-completion pairs",
  "main": "index.js",
  "scripts": {
    "test": "forge test && npm run verify:recovery-v2-artifact && node --test && npm run test:cloudflare && npm run test:helper-ledger",
    "test:cloudflare": "vitest run --config vitest.config.mjs",
    "test:helper-ledger": "vitest run --config vitest.helper.config.mjs",
    "build": "forge build && vite build && node scripts/verify-web-build-origin.mjs same-origin",
    "build:contracts": "forge build",
    "build:web": "vite build && node scripts/verify-web-build-origin.mjs same-origin",
    "build:web:cloudflare": "VITE_RETRYCREDIT_API_ORIGIN=https://retrycredit-api.onrender.com vite build && node scripts/verify-web-build-origin.mjs production",
    "build:web:cloudflare:staging": "VITE_RETRYCREDIT_API_ORIGIN=https://retrycredit-api-staging.qdworld001.workers.dev vite build && node scripts/verify-web-build-origin.mjs staging",
    "app:dev": "vite",
    "cohort:discover": "node scripts/discover-direct-usdc-cohort.mjs",
    "verify:mainnet-gate": "node scripts/verify-mainnet-gate.mjs",
    "verify:recovery-gate": "node scripts/verify-seadrop-recovery-gate.mjs",
    "discover:seadrop-wallet": "node scripts/discover-seadrop-wallet-pairs.mjs",
    "artifact:recovery-v2": "forge build && node scripts/generate-recovery-v2-artifact.mjs --write",
    "verify:recovery-v2-artifact": "node scripts/generate-recovery-v2-artifact.mjs --check",
    "worker": "node src/server.mjs",
    "worker:cloudflare:check": "wrangler deploy --dry-run --config wrangler.staging.jsonc",
    "worker:cloudflare:dev": "wrangler dev --config wrangler.staging.jsonc --remote",
    "worker:cloudflare:deploy:staging": "wrangler deploy --config wrangler.staging.jsonc"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@gluwa/usc-contracts": "^0.1.2",
    "@gluwa/usc-sdk": "^0.18.0",
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright-core": "^1.62.1",
    "vite": "^8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
